{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "positionX": "right",
    "positionY": "bottom",
    "layer": "overlay",
    "control-center-layer": "top",
    "control-center-positionY": "top",
    "layer-shell": true,
    "cssPriority": "user",
    "control-center-margin-top": 12,
    "control-center-margin-bottom": 423,
    "control-center-margin-right": 12,
    "control-center-margin-left": 0,
    "control-center-width": 378,
    "fit-to-screen": false,
    "control-center-height": 410,
    "notification-window-width": 380,
    "notification-icon-size": 48,
    "notification-body-image-height": 120,
    "notification-body-image-width": 200,
    "timeout": 6,
    "timeout-low": 4,
    "timeout-critical": 0,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "notification-grouping": false,
    "transition-time": 180,
    "hide-on-clear": false,
    "hide-on-action": true,
    "script-fail-notify": true,
    "scripts": {
        "popup-limit": {
            "exec": "sh -c 'exec \"$HOME/.config/hypr/winshell/winshell-ctl\" notified \"$SWAYNC_ID\" \"$SWAYNC_URGENCY\"'",
            "summary": ".*",
            "run-on": "receive"
        }
    },
    "widgets": [
        "title",
        "dnd",
        "notifications"
    ],
    "widget-config": {
        "title": {
            "text": "Notifications",
            "clear-all-button": true,
            "button-text": "Clear all"
        },
        "dnd": {
            "text": "Do not disturb"
        }
    }
}
