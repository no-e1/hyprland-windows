{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "positionX": "right",
    "positionY": "bottom",
    "layer": "overlay",
    "control-center-layer": "top",
    "control-center-positionY": "top",
    "layer-shell": true,
    "cssPriority": "user",
    "control-center-margin-top": 12,
    "control-center-margin-bottom": 0,
    "control-center-margin-right": 12,
    "control-center-margin-left": 0,
    "control-center-width": 378,
    "fit-to-screen": false,
    "control-center-height": 410,
    "notification-window-width": 388,
    "notification-icon-size": 48,
    "notification-body-image-height": 186,
    "notification-body-image-width": 332,
    "timeout": 6,
    "timeout-low": 4,
    "timeout-critical": 0,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "notification-grouping": true,
    "transition-time": 180,
    "hide-on-clear": false,
    "hide-on-action": true,
    "script-fail-notify": true,
    "scripts": {
        "popup-limit": {
            "exec": "sh -c 'exec \"$HOME/.config/hypr/winshell/winshell-ctl\" notified \"$SWAYNC_ID\" \"$SWAYNC_URGENCY\"'",
            "summary": ".*",
            "run-on": "receive"
        }
    },
    "widgets": [
        "title",
        "buttons-grid",
        "notifications"
    ],
    "widget-config": {
        "title": {
            "text": "Notifications",
            "clear-all-button": true,
            "button-text": "Clear all"
        },
        "buttons-grid": {
            "buttons-per-row": 1,
            "actions": [
                {
                    "label": " ",
                    "type": "toggle",
                    "command": "sh -c 'if [ \"$SWAYNC_TOGGLE_STATE\" = true ]; then swaync-client -dn; else swaync-client -df; fi'",
                    "update-command": "swaync-client -D"
                }
            ]
        }
    },
    "text-empty": "No new notifications"
}
