+
+// ── Windows-like window dragging (every window, also apps with their own
+//    title bar such as Brave or Discord, whose drags hyprbars never sees) ──
+//  * as soon as a window is being moved, a maximized one shrinks back
+//    (winctl.sh drag-start)
+//  * when it is dropped: at the top edge it maximizes, at the left/right
+//    edge it snaps to that half; anywhere else it is pushed back below the
+//    top and right of the left edge (winctl.sh drag-end <edge>)
+static bool s_moveDrag = false;
+
+static void onDragMotion() {
+    if (g_layoutManager->dragController()->mode() != MBIND_MOVE || s_moveDrag)
+        return;
+    s_moveDrag = true;
+    Config::Supplementary::executor()->spawn("$HOME/.config/hypr/scripts/winctl.sh drag-start");
+}
+
+static void onDragEnded() {
+    if (!s_moveDrag)
+        return;
+    s_moveDrag = false;
+    const auto  MOUSE = g_pInputManager->getMouseCoordsInternal();
+    const auto  MON   = Desktop::focusState()->monitor();
+    std::string edge  = "none";
+    if (MON) {
+        if (MOUSE.y <= MON->m_position.y + 3)
+            edge = "top";
+        else if (MOUSE.x <= MON->m_position.x + 3)
+            edge = "left";
+        else if (MOUSE.x >= MON->m_position.x + MON->m_size.x - 4)
+            edge = "right";
+    }
+    Config::Supplementary::executor()->spawn("$HOME/.config/hypr/scripts/winctl.sh drag-end " + edge);
+}
+
+// ── App minimize buttons ──
+// Hyprland drops an app's own "minimize" request (xdg_toplevel.set_minimized,
+// the – button of Brave, Discord, Steam, …). Catch it where the request
+// arrives and minimize the window like the title bar button does.
+using onUpdateStateFn            = void (*)(Desktop::View::CWindow*, const Desktop::View::SBackendStateRequest&);
+inline CFunctionHook* g_pStateHook = nullptr;
+
+static void hkOnUpdateState(Desktop::View::CWindow* self, const Desktop::View::SBackendStateRequest& request) {
+    if (request.minimized.value_or(false))
+        Config::Supplementary::executor()->spawn(std::format("$HOME/.config/hypr/scripts/winctl.sh minimize-window 0x{:x}", (uintptr_t)self));
+    ((onUpdateStateFn)g_pStateHook->m_original)(self, request);
+}
+
+static void hookMinimizeRequests() {
+    for (const auto& fn : HyprlandAPI::findFunctionsByName(PHANDLE, "onUpdateState")) {
+        if (fn.demangled.find("CWindow::onUpdateState") == std::string::npos)
+            continue;
+        g_pStateHook = HyprlandAPI::createFunctionHook(PHANDLE, fn.address, (void*)&hkOnUpdateState);
+        if (g_pStateHook && g_pStateHook->hook())
+            return;
+    }
+    HyprlandAPI::addNotification(PHANDLE, "[hyprbars] could not hook app minimize requests", CHyprColor{1.0, 0.5, 0.2, 1.0}, 6000);
+}
