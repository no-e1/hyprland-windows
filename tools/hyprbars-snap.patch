+
+// ── Windows-like window dragging (every window, also apps with their own
+//    title bar such as Brave or Discord, whose drags hyprbars never sees) ──
+//  * as soon as a window is being moved, a maximized one shrinks back
+//    (winctl.sh drag-start)
+//  * when it is dropped: at the top edge it maximizes, at the left/right
+//    edge it snaps to that half; anywhere else it is pushed back below the
+//    top and right of the left edge (winctl.sh drag-end <edge>)
+static bool s_moveDrag = false;
+
+static void onDragMotion() {
+    if (g_layoutManager->dragController()->mode() != MBIND_MOVE || s_moveDrag)
+        return;
+    s_moveDrag = true;
+    Config::Supplementary::executor()->spawn("$HOME/.config/hypr/scripts/winctl.sh drag-start");
+}
+
+static void onDragEnded() {
+    if (!s_moveDrag)
+        return;
+    s_moveDrag = false;
+    const auto  MOUSE = g_pInputManager->getMouseCoordsInternal();
+    const auto  MON   = Desktop::focusState()->monitor();
+    std::string edge  = "none";
+    if (MON) {
+        if (MOUSE.y <= MON->m_position.y + 3)
+            edge = "top";
+        else if (MOUSE.x <= MON->m_position.x + 3)
+            edge = "left";
+        else if (MOUSE.x >= MON->m_position.x + MON->m_size.x - 4)
+            edge = "right";
+    }
+    Config::Supplementary::executor()->spawn("$HOME/.config/hypr/scripts/winctl.sh drag-end " + edge);
+}
+
+// ── App minimize buttons ──
+// An app's own "–" (Brave, Discord, …) asks the compositor to minimize it;
+// Hyprland drops that request entirely (window.minimize only comes from
+// taskbars via foreign-toplevel). Listen to every window's requests and let
+// hyprland.lua minimize it (animated, like the title bar's –).
+static std::unordered_map<uintptr_t, Hyprutils::Signal::CHyprSignalListener> s_stateListeners;
+
+static void watchMinimize(PHLWINDOW w) {
+    if (!w)
+        return;
+    const auto ADDR = (uintptr_t)w.get();
+    s_stateListeners[ADDR] = w->backend().m_events.stateRequest.listen([ADDR](const Desktop::View::SBackendStateRequest& r) {
+        if (r.minimized.value_or(false))
+            Config::Supplementary::executor()->spawn(std::format("$HOME/.config/hypr/scripts/winctl.sh minimize-window 0x{:x}", ADDR));
+    });
+}
+
+// ── Tell an app whether it is maximized ──
+// Hyprland tells every app "maximized" once when it maps and never changes
+// it (so GTK apps don't draw their own frames). Apps with their own title bar
+// (Brave, Discord, …) then always show "restore" and, after one click,
+// wait for an answer that never comes – their □ button works only once.
+// hyprland.lua calls this whenever it maximizes / restores such an app.
+int setLuaMaximized(lua_State* L) {
+    const auto WINDOW = Config::Lua::Bindings::Internal::windowFromLuaSelectorOrObject(L, 1, "hl.plugin.hyprbars.set_maximized");
+    if (!WINDOW)
+        return Config::Lua::Bindings::Internal::configError(L, "hl.plugin.hyprbars.set_maximized: expected a window");
+    const bool ON   = lua_toboolean(L, 2);
+    const auto SURF = WINDOW->backend().surface();
+    if (SURF && SURF->m_role && SURF->m_role->role() == SURFACE_ROLE_XDG_SHELL) {
+        const auto XDG = ((CXDGSurfaceRole*)SURF->m_role.get())->m_xdgSurface.lock();
+        if (XDG && XDG->m_toplevel)
+            XDG->m_toplevel->setMaximized(ON);
+    }
+    return 0;
+}
+
+// ── App maximize / restore buttons ──
+// An app's own maximize / restore (Brave's □ button) arrives as a "maximize"
+// request – Hyprland can't tell the two apart with the Windows-style maximize
+// of hyprland.lua (it inverts its own maximized state, which that doesn't
+// use) and swallows every other one as an "echo". So take it here and let
+// hyprland.lua toggle. (App minimize requests reach it as window.minimize.)
+using requestClientFullscreenFn = void (*)(Desktop::View::CWindow*, const Desktop::View::SClientFullscreenRequest&);
+inline CFunctionHook* g_pFsHook = nullptr;
+
+static void hkRequestClientFullscreen(Desktop::View::CWindow* self, const Desktop::View::SClientFullscreenRequest& request) {
+    using Req = Desktop::View::SClientFullscreenRequest;
+    if (request.origin == Req::ORIGIN_BACKEND && request.maximized.has_value() && !request.fullscreen.has_value()) {
+        Config::Supplementary::executor()->spawn(std::format("$HOME/.config/hypr/scripts/winctl.sh togglemax-window 0x{:x}", (uintptr_t)self));
+        return;
+    }
+    ((requestClientFullscreenFn)g_pFsHook->m_original)(self, request);
+}
+
+static void hookMaximizeRequests() {
+    for (const auto& fn : HyprlandAPI::findFunctionsByName(PHANDLE, "requestClientFullscreen")) {
+        if (fn.demangled.find("CWindow::requestClientFullscreen") == std::string::npos)
+            continue;
+        g_pFsHook = HyprlandAPI::createFunctionHook(PHANDLE, fn.address, (void*)&hkRequestClientFullscreen);
+        if (g_pFsHook && g_pFsHook->hook())
+            return;
+    }
+    HyprlandAPI::addNotification(PHANDLE, "[hyprbars] could not hook app maximize requests", CHyprColor{1.0, 0.5, 0.2, 1.0}, 6000);
+}
+
