[Unit]
Description=Drop the double clicks of a mouse with a worn switch (Attack Shark X11)
After=systemd-udevd.service

[Service]
ExecStart=/usr/local/libexec/mouse-debounce.py
Restart=always
RestartSec=2
# it only needs the input devices and uinput
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
