+        // Removal (progress 1 -> 0): the first 60 % slide it out to the right
+        // while it fades, the rest shrink its height so the gap closes.
+        private double slide_out () {
+            return (1.0 - animation_target.progress).clamp (0.0, 0.6) / 0.6;
+        }
+
+        private double height_left () {
+            return (animation_target.progress / 0.4).clamp (0.0, 1.0);
+        }
+
+        protected override void measure (Gtk.Orientation orientation, int for_size,
+                                         out int minimum, out int natural,
+                                         out int minimum_baseline, out int natural_baseline) {
+            minimum = natural = 0;
+            minimum_baseline = natural_baseline = -1;
+            Gtk.Widget ?child = get_child ();
+            if (child == null || !child.should_layout ()) {
+                return;
+            }
+            child.measure (orientation, for_size, out minimum, out natural,
+                           out minimum_baseline, out natural_baseline);
+            double h = height_left ();
+            if (orientation == Gtk.Orientation.VERTICAL && h < 1.0) {
+                minimum = (int) Math.ceil (minimum * h);
+                natural = (int) Math.ceil (natural * h);
+                minimum_baseline = -1;
+                natural_baseline = -1;
+            }
+        }
+
+        protected override void size_allocate (int width, int height, int baseline) {
+            Gtk.Widget ?child = get_child ();
+            if (child == null || !child.should_layout ()) {
+                return;
+            }
+            if (slide_out () <= 0.0 && height_left () >= 1.0) {
+                child.allocate (width, height, baseline, null);
+                return;
+            }
+            int min, nat;
+            child.measure (Gtk.Orientation.VERTICAL, width, out min, out nat, null, null);
+            Gsk.Transform transform = new Gsk.Transform ().translate (
+                Graphene.Point ().init ((float) (width * slide_out ()), 0));
+            child.allocate (width, int.max (height, nat), -1, transform);
+        }
+
         protected override void snapshot (Gtk.Snapshot snapshot) {
             if (!base.should_layout ()) {
                 return;
             }
 
-            snapshot.push_opacity (animation_target.progress);
+            snapshot.push_opacity (1.0 - slide_out ());
             base.snapshot (snapshot);
             snapshot.pop ();
         }
