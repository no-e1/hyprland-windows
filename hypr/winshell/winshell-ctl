#!/usr/bin/env bash
# Sends a command to the winshell daemon and starts the daemon if needed.
#   winshell-ctl switch next|prev|commit|cancel
#   winshell-ctl qs [toggle|main|wifi|bluetooth|hide]
#   winshell-ctl menu [hide] | search <text> | calendar [hide] | osd volume|brightness|mic
#   winshell-ctl settings [hide]   the settings flyout (Win + I)
#   winshell-ctl tray [menu | hide <id> | show <id>]   hidden-icons flyout, first icon menu, hide/show an icon
#   winshell-ctl notified <id> <urgency>   (swaync script: keeps at most 3 popups)
#   winshell-ctl start | restart
#   winshell-ctl supervise   keep winshell (and so the taskbar) running, restart
#                            it if it ever crashes (Hyprland autostart)
RUN="${XDG_RUNTIME_DIR:-/tmp}"
FIFO="$RUN/winshell.fifo"
READY="$RUN/winshell.ready"
DIR="$(dirname "$(realpath "$0")")"

pid() { cat "$READY" 2>/dev/null; }
running() {
    local p; p=$(pid)
    [ -n "$p" ] && grep -q "winshell.py" "/proc/$p/cmdline" 2>/dev/null && [ -p "$FIFO" ]
}

# GSK_DEBUG=full-redraw: GTK otherwise repaints only the changed area and
# leaves bits of old text behind on these layer surfaces (flickering white
# marks in the Wi-Fi list, the calendar, …)
run() {
    GSK_DEBUG=full-redraw LC_TIME=en_GB.UTF-8 LD_PRELOAD=/usr/lib64/libgtk4-layer-shell.so.0 \
        python3 "$DIR/winshell.py" >>"$RUN/winshell.log" 2>&1
}

wait_running() {
    for _ in $(seq 1 100); do
        running && return 0
        sleep 0.03
    done
    return 1
}

start() {
    rm -f "$READY"
    : >"$RUN/winshell.log"
    ( run & )
    wait_running
}

supervised() { pgrep -f "winshell-ctl supervise" >/dev/null; }

case "$1" in
    supervise)
        while :; do run; sleep 1; done ;;
    start)   running || start; exit ;;
    restart)
        running && kill "$(pid)"
        sleep 0.3
        if supervised; then wait_running; else start; fi
        exit ;;
esac

running || start
printf '%s\n' "$*" 1<>"$FIFO"
