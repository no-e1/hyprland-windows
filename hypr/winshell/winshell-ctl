#!/usr/bin/env bash
# Sends a command to the winshell daemon and starts the daemon if needed.
#   winshell-ctl switch next|prev|commit|cancel
#   winshell-ctl qs [toggle|wifi|bluetooth|hide]
#   winshell-ctl menu [hide] | calendar [hide] | osd volume|brightness
#   winshell-ctl start | restart
RUN="${XDG_RUNTIME_DIR:-/tmp}"
FIFO="$RUN/winshell.fifo"
READY="$RUN/winshell.ready"
DIR="$(dirname "$(realpath "$0")")"

pid() { cat "$READY" 2>/dev/null; }
running() {
    local p; p=$(pid)
    [ -n "$p" ] && grep -q "winshell.py" "/proc/$p/cmdline" 2>/dev/null && [ -p "$FIFO" ]
}

start() {
    rm -f "$READY"
    LC_TIME=en_GB.UTF-8 LD_PRELOAD=/usr/lib64/libgtk4-layer-shell.so.0 \
        setsid -f python3 "$DIR/winshell.py" >"$RUN/winshell.log" 2>&1
    for _ in $(seq 1 100); do
        running && return
        sleep 0.03
    done
}

case "$1" in
    start)   running || start; exit ;;
    restart) running && kill "$(pid)"; sleep 0.3; start; exit ;;
esac

running || start
printf '%s\n' "$*" 1<>"$FIFO"
