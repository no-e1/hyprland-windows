#!/usr/bin/env bash
# Sends a command to the winshell daemon and starts the daemon if needed.
#   winshell-ctl switch next|prev|commit|cancel
#   winshell-ctl qs [toggle|wifi|bluetooth|hide]
#   winshell-ctl start | restart
RUN="${XDG_RUNTIME_DIR:-/tmp}"
FIFO="$RUN/winshell.fifo"
DIR="$(dirname "$(realpath "$0")")"

start() {
    LD_PRELOAD=/usr/lib64/libgtk4-layer-shell.so.0 setsid -f python3 "$DIR/winshell.py" \
        >"$RUN/winshell.log" 2>&1
    for _ in $(seq 1 100); do
        [ -f "$RUN/winshell.ready" ] && pgrep -f "python3 .*/winshell/winshell.py" >/dev/null && return
        sleep 0.03
    done
}

running() { pgrep -f "python3 .*/winshell/winshell.py" >/dev/null && [ -p "$FIFO" ]; }

case "$1" in
    start)   running || start; exit ;;
    restart) pkill -f "python3 .*/winshell/winshell.py"; rm -f "$RUN/winshell.ready"; sleep 0.2; start; exit ;;
esac

running || { rm -f "$RUN/winshell.ready"; start; }
printf '%s\n' "$*" 1<>"$FIFO"
