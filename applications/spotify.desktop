[Desktop Entry]
Name=Spotify
GenericName=Music Player
Comment=Listen to music using Spotify
Icon=win11-app-spotify
# native Wayland (sharp at 200 %); through XWayland it is drawn at half
# resolution and stretched – blurry. On Wayland it draws no – □ X:
# it gets the Windows title bar (hyprland.lua OWN_TITLEBAR) (hyprland-windows)
Exec=/bin/bash /usr/bin/spotify --enable-features=UseOzonePlatform --ozone-platform=wayland %U
TryExec=/bin/bash
Terminal=false
Type=Application
Categories=Audio;AudioVideo;Player;
MimeType=x-scheme-handler/spotify;
StartupWMClass=spotify
