// Windows 11 style taskbar
{
    "layer": "top",
    "position": "bottom",
    "height": 48,
    "spacing": 0,
    "exclusive": true,
    "reload_style_on_change": true,

    "modules-left":   [],
    "modules-center": ["custom/start", "custom/pin-explorer", "custom/pin-browser", "custom/pin-terminal", "wlr/taskbar"],
    "modules-right":  ["tray", "group/quick", "clock", "custom/peek"],


    "custom/start": {
        "format": " ",
        "tooltip-format": "Start",
        "on-click": "~/.config/hypr/scripts/startmenu.sh"
    },

    "custom/pin-explorer": {
        "exec": "~/.config/hypr/scripts/pinned.sh status '^nemo$' 'File Explorer'",
        "return-type": "json",
        "interval": 2,
        "on-click": "~/.config/hypr/scripts/pinned.sh open '^nemo$' nemo",
        "on-click-middle": "nemo"
    },

    "custom/pin-browser": {
        "exec": "~/.config/hypr/scripts/pinned.sh status '^(brave-browser)$' 'Brave'",
        "return-type": "json",
        "interval": 2,
        "on-click": "~/.config/hypr/scripts/pinned.sh open '^(brave-browser)$' brave-browser",
        "on-click-middle": "brave-browser --new-window"
    },

    "custom/pin-terminal": {
        "exec": "~/.config/hypr/scripts/pinned.sh status '^kitty$' 'Terminal'",
        "return-type": "json",
        "interval": 2,
        "on-click": "~/.config/hypr/scripts/pinned.sh open '^kitty$' kitty",
        "on-click-middle": "kitty"
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 24,
        "icon-theme": "Win11-modern",
        "tooltip-format": "{title}",
        "on-click": "minimize-raise",
        "on-click-middle": "close",
        "ignore-list": ["nemo", "brave-browser", "kitty"]
    },

    "tray": {
        "icon-size": 16,
        "spacing": 12
    },

    "group/quick": {
        "orientation": "horizontal",
        "modules": ["custom/net", "custom/vol", "custom/bat"]
    },

    "custom/net": {
        "exec": "~/.config/waybar/scripts/status.sh net",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "~/.config/hypr/winshell/winshell-ctl qs",
        "on-click-right": "~/.config/hypr/winshell/winshell-ctl qs wifi"
    },

    "custom/vol": {
        "exec": "~/.config/waybar/scripts/status.sh vol",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "~/.config/hypr/winshell/winshell-ctl qs",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },

    "custom/bat": {
        "exec": "~/.config/waybar/scripts/status.sh bat",
        "return-type": "json",
        "interval": 20,
        "on-click": "~/.config/hypr/winshell/winshell-ctl qs"
    },

    "clock": {
        "format": "{:%H:%M:%S\n%d.%m.%Y}",
        "interval": 1,
        "justify": "right",
        "tooltip": false,
        "on-click": "~/.config/hypr/winshell/winshell-ctl calendar"
    },

    "custom/peek": {
        "format": " ",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/wallpaper.sh next"
    }
}
