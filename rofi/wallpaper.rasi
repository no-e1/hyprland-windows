/* Background picker with previews (Win + W) */
@import "colors.rasi"

configuration {
    show-icons:      true;
    hover-select:    true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

window {
    location:         center;
    width:            900px;
    border:           1px;
    border-color:     @border;
    border-radius:    10px;
    background-color: @bg;
}
mainbox  { padding: 18px; spacing: 14px; children: [ "inputbar", "listview" ]; }
/* search field like Windows 11 (same as winshell's start menu): a dark
   round pill with a light edge and the colored magnifier */
inputbar {
    padding:          0 16px;
    spacing:          10px;
    border:           1px;
    border-color:     #ffffff1a;
    border-radius:    18px;
    background-color: #1f1f1f;
    children:         [ "icon-search", "entry" ];
}
icon-search { expand: false; filename: "win11-search"; size: 20px; vertical-align: 0.5; }
entry    { placeholder: "Search"; placeholder-color: @fg-dim; vertical-align: 0.5; padding: 9px 0; cursor: text; }
listview { columns: 3; lines: 2; spacing: 10px; fixed-height: true; scrollbar: false; }
element {
    orientation:   vertical;
    padding:       8px;
    spacing:       6px;
    border-radius: 8px;
    cursor:        pointer;
}
element selected.normal { background-color: @selected; }
element-icon { size: 150px; horizontal-align: 0.5; cursor: inherit; }
element-text { horizontal-align: 0.5; font: "Inter 9, Noto Sans 9"; cursor: inherit; }
