/* Simple list: settings, run, clipboard */
@import "colors.rasi"

configuration {
    show-icons:      false;
    hover-select:    true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

window {
    location:         center;
    anchor:           center;
    width:            460px;
    border:           1px;
    border-color:     @border;
    border-radius:    10px;
    background-color: @bg;
}
mainbox  { padding: 14px; spacing: 10px; children: [ "inputbar", "message", "listview" ]; }
inputbar {
    padding:          9px 14px;
    spacing:          10px;
    border:           0 0 2px 0;
    border-color:     @accent;
    border-radius:    6px;
    background-color: @surface;
    children:         [ "prompt", "entry" ];
}
prompt   { text-color: @fg-dim; }
entry    { placeholder: "Search…"; placeholder-color: @fg-dim; }
listview { lines: 9; fixed-height: false; scrollbar: false; spacing: 2px; }
element {
    padding:       9px 12px;
    border-radius: 6px;
    cursor:        pointer;
}
element selected.normal { background-color: @selected; }
element-text { font: "Segoe UI Variable Text 10.5, Inter 10.5, Noto Sans 10.5, Symbols Nerd Font 10.5"; cursor: inherit; }
