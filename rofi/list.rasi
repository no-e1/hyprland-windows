/* Simple list: settings, run, clipboard */
@import "colors.rasi"

configuration {
    show-icons:      false;
    hover-select:    true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    /* the mouse wheel doesn't move the selection (like Windows): arrow keys,
       a click or Enter pick an entry */
    ml-row-up:       "";
    ml-row-down:     "";
    ml-row-left:     "";
    ml-row-right:    "";
}

window {
    location:         center;
    anchor:           center;
    width:            460px;
    border:           1px;
    border-color:     @border;
    border-radius:    10px;
    background-color: @bg;
}
mainbox  { padding: 14px; spacing: 10px; children: [ "inputbar", "message", "listview" ]; }
/* search field like Windows 11 (same as winshell's start menu): a dark
   round pill with a light edge and the colored magnifier */
inputbar {
    padding:          0 16px;
    spacing:          10px;
    border:           1px;
    border-color:     #ffffff1a;
    border-radius:    18px;
    background-color: #1f1f1f;
    children:         [ "icon-search", "entry" ];
}
icon-search { expand: false; filename: "win11-search"; size: 20px; vertical-align: 0.5; }
entry    { placeholder: "Search"; placeholder-color: @fg-dim; vertical-align: 0.5; padding: 9px 0; cursor: text; }
listview { lines: 9; fixed-height: false; scrollbar: false; spacing: 2px; }
element {
    padding:       9px 12px;
    border-radius: 6px;
    cursor:        pointer;
}
element selected.normal { background-color: @selected; }
element-text { font: "Segoe UI Variable Text 10.5, Inter 10.5, Noto Sans 10.5, Symbols Nerd Font 10.5"; cursor: inherit; }
